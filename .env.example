# Copy to .env and fill in. Never commit .env.
POSTGRES_USER=bazaraf
POSTGRES_PASSWORD=change-me
POSTGRES_DB=bazaraf
DATABASE_URL=postgresql+psycopg://bazaraf:change-me@db:5432/bazaraf
JWT_SECRET=generate-with-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Demo data only (python -m app.seed). Pick any password with 10+ chars, letters and digits. Seeding refuses to run in production.
SEED_PASSWORD=choose-a-demo-password-1
BCRYPT_ROUNDS=12

# Frontend (server-side only; the browser never talks to the API directly)
API_URL=http://localhost:8000/api/v1
COOKIE_SECURE=true
