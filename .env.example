# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# --- PostgreSQL (docker compose builds the connection string from these) ---
POSTGRES_USER=bazaraf
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=bazaraf

# --- API ---
# production: hides /docs and requires a strong JWT_SECRET. Use "development" to see Swagger at :8000/docs
ENVIRONMENT=production
JWT_SECRET=generate-with-openssl-rand-hex-32
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
BCRYPT_ROUNDS=12
CORS_ORIGINS=http://localhost:3000
# Running the API outside Docker? point it at your own database:
# DATABASE_URL=postgresql+psycopg://bazaraf:change-me@localhost:5432/bazaraf

# --- Email (password reset + email confirmation) via Resend: https://resend.com ---
# Leave RESEND_API_KEY empty to run without email (the link is written to the API log in development).
# Never commit a real key. APP_URL is the public address of the web app; it is used to build the links inside emails.
RESEND_API_KEY=
EMAIL_FROM=Bazar.af <onboarding@resend.dev>
APP_URL=http://localhost:3000

# --- Web (server-side only; the browser never calls the API directly) ---
API_URL=http://localhost:8000/api/v1
# true when served over HTTPS (production); false only for http://localhost
COOKIE_SECURE=false

# --- Demo data only: `python -m app.seed` / `docker compose --profile seed run --rm seed` ---
# Any password with 10+ characters, letters and digits. Seeding refuses to run in production.
SEED_PASSWORD=choose-a-demo-password-1
